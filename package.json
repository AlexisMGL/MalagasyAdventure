{
  "name": "malagasy-adventure",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Apprentissage du malgache pour francophones — dépôt indépendant.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:audio-tools": "node --test scripts/*.test.mjs",
    "test:all": "npm run test && npm run test:audio-tools && npm run test:e2e && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "audio:inventory": "node scripts/prepare-malagasy-neural.mjs",
    "audio:plan": "node scripts/malagasy-neural.mjs --plan",
    "audio:generate": "node scripts/malagasy-neural.mjs",
    "audio:review": "node scripts/malagasy-audio-review.mjs --port 5191",
    "audio:check": "node scripts/check-malagasy-neural.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
